<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hkust</groupId>
    <artifactId>marketplace</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>HKUST Marketplace</name>
    <description>HKUST Campus Marketplace - Frontend Demo / Skeleton (JavaFX)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <javafx.version>21.0.2</javafx.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
        <junit.version>5.11.4</junit.version>
        <jackson.version>2.18.2</jackson.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!-- Screens and app start-up: no logic of their own, so not part of the coverage rule (see jacoco below) -->
        <jacoco.ui.excludes>com/hkust/marketplace/controllers/**,com/hkust/marketplace/MarketplaceApp.class,com/hkust/marketplace/utils/SceneManager.class,com/hkust/marketplace/utils/DevLogin.class,com/hkust/marketplace/ui/Dialogs.class,com/hkust/marketplace/ui/NotificationBoard.class,com/hkust/marketplace/ui/ProfileView.class,com/hkust/marketplace/ui/ListingCard.class,com/hkust/marketplace/ui/ChatView.class,com/hkust/marketplace/ui/ChatList.class,com/hkust/marketplace/ui/PhotoFrame.class,com/hkust/marketplace/ui/SubScreen.class,com/hkust/marketplace/ui/ReviewList.class</jacoco.ui.excludes>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Jackson: turns the data into JSON for the encrypted save file (data/EncryptedJsonStorage) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <!-- Dates and durations (LocalDateTime, Duration) in JSON -->
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- JUnit 5 for unit tests (Lab 7) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <!-- Runs the JUnit 5 tests with "mvnw test" -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <mainClass>com.hkust.marketplace.MarketplaceApp</mainClass>
                </configuration>
            </plugin>

            <!-- ===== Submission reports: all produced by "mvnw clean verify" (see README, "Reports") ===== -->

            <plugin>
                <!-- Code coverage. Two reports: the measured code (models, data, services, utils) that the
                     >65% branch-coverage rule applies to, and everything, screens included, for reference.
                     Screens are excluded from the rule because they hold no logic of their own (they call
                     the tested services) and are checked by the manual acceptance tests instead. -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-measured</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/reports/jacoco</outputDirectory>
                            <excludes>${jacoco.ui.excludes}</excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report-all</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/reports/jacoco-all</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-branch-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>${jacoco.ui.excludes}</excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.65</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- HTML unit-test report (target/reports/surefire.html) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <id>test-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-only</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- JavaDoc of all classes (target/reports/apidocs/index.html) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <doctitle>HKUST Marketplace API</doctitle>
                    <windowtitle>HKUST Marketplace API</windowtitle>
                    <!-- Check links, HTML and syntax, but don't demand @param/@return on every simple getter -->
                    <doclint>all,-missing</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>javadoc</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>javadoc</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- DEV-ONLY: "mvnw clean javafx:run -Pdev" pre-fills the login forms with test accounts
             (see utils/DevLogin.java). Remove this profile before the final release. -->
        <profile>
            <id>dev</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <configuration>
                            <options>
                                <option>-Dmarketplace.dev=true</option>
                            </options>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
