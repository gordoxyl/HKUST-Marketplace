<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hkust.marketplace.controllers.seller.SellerRegisterController"
           styleClass="welcome-bg" prefWidth="1200" prefHeight="780">

    <!-- The scroll area's content fills the window and centres the card, which keeps its own width
         (regression log R19). minHeight -Infinity is USE_PREF_SIZE: a short window scrolls the form
         instead of squeezing it. -->
    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
        <VBox alignment="CENTER" spacing="0" minHeight="-Infinity" style="-fx-padding: 30 0;">
            <VBox alignment="CENTER" spacing="14" styleClass="auth-pane" maxWidth="460">
                <HBox alignment="CENTER" spacing="12">
                    <ImageView fitHeight="46" fitWidth="30" preserveRatio="true">
                        <image>
                            <Image url="@../../images/hkust_logo.png"/>
                        </image>
                    </ImageView>
                    <Label text="Seller Registration" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #A68137;"/>
                </HBox>

                <VBox spacing="5">
                    <Label text="Username *" style="-fx-font-weight: 600;"/>
                    <TextField fx:id="usernameField" promptText="Unique username" prefHeight="38"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Full Name *" style="-fx-font-weight: 600;"/>
                    <TextField fx:id="fullNameField" promptText="Your full name" prefHeight="38"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Password *" style="-fx-font-weight: 600;"/>
                    <PasswordField fx:id="passwordField" promptText="Min 8 chars: upper, lower, digit, symbol" prefHeight="38"/>
                    <!-- Task 2.1: show the password rules under the field -->
                    <Label fx:id="passwordRulesLabel" wrapText="true"
                           style="-fx-text-fill: #9aa0b0; -fx-font-size: 11px;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Confirm Password *" style="-fx-font-weight: 600;"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" prefHeight="38"/>
                </VBox>
                <VBox spacing="5">
                    <!-- Task 2.1: multiple meet-up locations (was a single ComboBox) -->
                    <Label text="Preferred Meet-up Locations (optional)" style="-fx-font-weight: 600;"/>
                    <FlowPane fx:id="meetupChoices" hgap="12" vgap="6" prefWrapLength="380"/>
                    <Label text="Choose any that apply." style="-fx-text-fill: #9aa0b0; -fx-font-size: 11px;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Seller Bio (optional)" style="-fx-font-weight: 600;"/>
                    <TextArea fx:id="bioArea" promptText="Short introduction..." prefRowCount="3"/>
                </VBox>

                <Label fx:id="errorLabel" text="" style="-fx-text-fill: #c62828; -fx-font-size: 13px;"
                       wrapText="true" managed="false" visible="false"/>
                <Label fx:id="successLabel" text="" style="-fx-text-fill: #2e7d32; -fx-font-size: 13px;"
                       wrapText="true" managed="false" visible="false"/>

                <Button text="Create Seller Account" styleClass="btn-gold" onAction="#handleRegister"
                        prefWidth="Infinity" prefHeight="42"/>

                <HBox alignment="CENTER" spacing="6">
                    <Label text="Already registered?" style="-fx-text-fill: #5a5a7a;"/>
                    <Hyperlink text="Login here" onAction="#goLogin"/>
                </HBox>
                <Hyperlink text="← Back to Welcome" onAction="#goWelcome"/>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
